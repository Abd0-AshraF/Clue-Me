# Clue Me — production environment example
# Wispbyte: add these in Startup / Variables. Do not upload a real .env publicly.

NODE_ENV=production

# Wispbyte injects SERVER_PORT automatically. Usually leave PORT unset.
# PORT=3001

# Canonical HTTPS origin, without a trailing slash.
PUBLIC_URL=https://clueme.wisp.uno

# Comma-separated account emails that should be administrators.
# Example: ADMIN_EMAILS=owner@example.com
ADMIN_EMAILS=

# -----------------------------------------------------------------------------
# PostgreSQL (Neon recommended)
# Copy the pooled connection string from Neon → Connection Details.
# It normally starts with postgresql:// and includes sslmode=require.
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_SSL=true
DATABASE_SAVE_INTERVAL_MS=3000

# -----------------------------------------------------------------------------
# Discord OAuth2 + Discord Activity
# Create the app at https://discord.com/developers/applications
# Client ID is public; Client Secret must remain server-side only.
# -----------------------------------------------------------------------------
DISCORD_CLIENT_ID=YOUR_DISCORD_APPLICATION_ID
DISCORD_CLIENT_SECRET=YOUR_DISCORD_CLIENT_SECRET
DISCORD_REDIRECT_URI=https://clueme.wisp.uno/api/auth/discord/callback
DISCORD_DOMAIN_VERIFICATION=dh=55cf526805f47c766ac5dd57b422bfe681af9400
DISCORD_MOCK_MODE=0

# Optional: invite link for the Discord server button on the landing page.
DISCORD_SERVER_INVITE_URL=https://discord.gg/YOUR_INVITE

# -----------------------------------------------------------------------------
# Google Gemini API (Game AI Engine: Pack generation, Spymaster/Guess Advisor)
# -----------------------------------------------------------------------------
GEMINI_API_KEY=
