{
  "id": "/",
  "name": "Clue Me",
  "short_name": "Clue Me",
  "description": "لعبة تخمين كلمات عربية جماعية للأصدقاء — أنشئ غرفة وابدأ اللعب مباشرة وبشكل فوري",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "tabbed",
    "standalone",
    "minimal-ui"
  ],
  "orientation": "portrait",
  "background_color": "#17131a",
  "theme_color": "#B83A3A",
  "lang": "ar",
  "dir": "rtl",
  "categories": ["games", "entertainment", "social"],
  "prefer_related_applications": false,
  "related_applications": [
    {
      "platform": "play",
      "url": "https://play.google.com/store/apps/details?id=com.clueme.game",
      "id": "com.clueme.game"
    },
    {
      "platform": "webapp",
      "url": "https://clue-me.ai.studio/manifest.json"
    }
  ],
  "scope_extensions": [
    {
      "origin": "https://clue-me.ai.studio"
    },
    {
      "origin": "https://ais-dev-frb66bk6gdpkcntddasbba-520664284111.europe-west3.run.app"
    },
    {
      "origin": "https://ais-pre-frb66bk6gdpkcntddasbba-520664284111.europe-west3.run.app"
    }
  ],
  "file_handlers": [
    {
      "action": "/",
      "name": "Clue Me Game Preset",
      "icons": [
        {
          "src": "/icon-96.png",
          "sizes": "96x96"
        }
      ],
      "accept": {
        "application/json": [".clueme", ".json"]
      }
    }
  ],
  "launch_handler": {
    "client_mode": ["navigate-existing", "auto"]
  },
  "edge_side_panel": {
    "preferred_width": 480
  },
  "share_target": {
    "action": "/",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "protocol_handlers": [
    {
      "protocol": "web+clueme",
      "url": "/?room=%s"
    }
  ],
  "widgets": [
    {
      "name": "Clue Me Quick Play",
      "short_name": "Clue Me",
      "description": "انضمام سريع لغرفة اللعب",
      "tag": "clueme-widget",
      "template": "widget",
      "ms_ac_template": "widget.json",
      "data": "widget-data.json",
      "type": "application/json",
      "screenshots": [
        {
          "src": "/discord-embed-v1.png",
          "sizes": "1200x630",
          "label": "Clue Me Widget"
        }
      ],
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "icons": [
    {
      "src": "/icon-96.png",
      "sizes": "96x96",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ],
  "screenshots": [
    {
      "src": "/discord-embed-v1.png",
      "sizes": "1200x630",
      "type": "image/png",
      "form_factor": "wide",
      "label": "شاشة لعبة Clue Me"
    },
    {
      "src": "/discord-embed-v1.png",
      "sizes": "1200x630",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "شاشة لعبة Clue Me للجوال"
    }
  ],
  "shortcuts": [
    {
      "name": "إنشاء أو دخول غرفة",
      "short_name": "لعب سريع",
      "description": "دخول اللعبة فورا",
      "url": "/",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ]
}
